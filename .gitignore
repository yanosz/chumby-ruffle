# Generated by Cargo
# will have compiled files and executables
/target/

# These are backup files generated by rustfmt
**/*.rs.bk

# SWF debug symbols
*.swd

# Flash recovery files
RECOVER_*.fla

# Jetbrains tools (CLion, IntelliJ, etc)
/.idea

# Mac junk
.DS_Store

# A developers local Flash Player harness config
.flash_players.toml

# --- chumby fork ---------------------------------------------------------
# Copyrighted chumby material — never commit any of it. controlpanel.swf
# goes in swf-assets/ (self-ignoring); widget SWFs, their preview
# thumbnails and the alarm tones are chumby firmware too. The appendix is
# the decompiled panel; the screenshots show its artwork.
/fixtures/**/*.swf
/fixtures/**/*.mp3
/fixtures/**/*.wav
/fixtures/widgets/*.jpg
# …except the USB-music test tones: sine waves we generate ourselves
# (fixtures/README.md), nothing chumby about them.
!/fixtures/rootfs/mnt/usb/**/*.mp3
/claude-docs/appendix/
/claude-docs/images/

# chumby-widget-channel's change-detection cache (runtime state; the
# committed profile + *.widget.xml sidecars are the source of truth).
/fixtures/widgets/.channel.sig

# Per-box dev identity, generated at first start (real_ident.rs).
/fixtures/rootfs/psp/guid
